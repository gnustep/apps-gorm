<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" targetRuntime="MacOSX.Cocoa">
  <objects>
    <customObject id="-2" userLabel="File's Owner" customClass="NSApplication"/>
    <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
    <window id="window" title="Gormtool conversion window">
      <rect key="contentRect" x="100" y="100" width="300" height="200"/>
      <view key="contentView" id="content">
        <rect key="frame" x="0" y="0" width="300" height="200"/>
        <subviews>
          <button id="button" tag="42">
            <rect key="frame" x="20" y="20" width="160" height="32"/>
            <buttonCell key="cell" id="button-cell" title="Convert this button" bezelStyle="rounded" type="push"/>
          </button>
        </subviews>
      </view>
    </window>
  </objects>
</document>
